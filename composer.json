{
    "name": "kylewlawrence/laravel-mainwp-api",
    "type": "library",
    "description": "Laravel API for MainWP",
    "minimum-stability": "stable",
    "keywords": [
        "mainwp",
        "laravel",
        "rest-api"
    ],
    "homepage": "https://klaw.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "KyleWLawrence",
            "email": "Kyle@klaw.dev"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^7.16 || ^8.3",
        "guzzlehttp/psr7": "^2.13 || ^3.2",
        "illuminate/support": "^13.0",
        "php": "^8.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "KyleWLawrence\\MainWP\\Providers\\MainWPServiceProvider"
            ],
            "aliases": {
                "MainWP": "KyleWLawrence\\MainWP\\Facades\\MainWP"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "KyleWLawrence\\MainWP\\": "src"
        }
    },
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/.history",
            "/.env",
            "/.env.*",
            "/composer.lock"
        ]
    }
}
